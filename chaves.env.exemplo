# Copie este arquivo para chaves.env e cole suas chaves (uma por linha, sem aspas).
# O chaves.env fica só no seu PC: ele está no .gitignore e nunca vai pro repositório.

# Jev (decisões rápidas) e Sonnet pelo OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# Opcional: chave direta da Anthropic pro Sonnet (sem ela, o Sonnet usa o OpenRouter)
ANTHROPIC_API_KEY=

# Estatísticas de elo alto: chave de desenvolvimento de developer.riotgames.com (expira em 24 h)
RIOT_API_KEY=
